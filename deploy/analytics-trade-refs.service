[Unit]
Description=Global Trade Intelligence reference metadata refresh
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=tradeapp
Group=tradeapp
WorkingDirectory=/opt/analytics-trade/backend
EnvironmentFile=/etc/analytics-trade/trade.env
ExecStart=/opt/analytics-trade/.venv/bin/python -m trade_api.cli bootstrap-refs
TimeoutStartSec=600
StandardOutput=journal
StandardError=journal
SyslogIdentifier=analytics-trade-refs
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
ReadWritePaths=/var/lib/analytics-trade
CapabilityBoundingSet=
