# Copy to .env (chmod 600) and fill in. NEVER commit the real file.
COMTRADE_API_KEY=your-primary-subscription-key
COMTRADE_API_KEY_SECONDARY=your-secondary-subscription-key

TRADE_DATA_DIR=/var/lib/analytics-trade
TRADE_HOST=127.0.0.1
TRADE_PORT=8092
TRADE_BASE_PATH=/trade
TRADE_LOG_LEVEL=INFO

# Call budget (free-tier shaped)
COMTRADE_DAILY_CALL_BUDGET=450
COMTRADE_INTERACTIVE_RESERVE=50
COMTRADE_GLOBAL_BACKFILL_BUDGET=100
COMTRADE_MIN_REQUEST_INTERVAL_SECONDS=1.2

# Ingestion defaults
TRADE_ANNUAL_HISTORY_START=2010
TRADE_MONTHLY_HISTORY_MONTHS=36
TRADE_BOOTSTRAP_COUNTRIES=AZE,CHN,USA,DEU,JPN,GBR,TUR,ITA,FRA,KOR

# Development
USE_FIXTURE_DATA=false

# IMF Data Portal (International Trade in Goods). Free subscription keys from
# https://api.imf.org — used for recent-period coverage that Comtrade has not
# published yet. No daily call budget, so this never competes with Comtrade.
IMF_API_KEY=
IMF_API_KEY_SECONDARY=
